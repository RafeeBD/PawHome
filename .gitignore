.env
.env.*
*.env
*.key
*.pem
*.secret

# Local configuration overrides
config.local.php

# User uploads - ignore runtime uploads but keep directory structure and protection
uploads/pets/*
!uploads/pets/.htaccess
!uploads/pets/.gitkeep

uploads/private/*
!uploads/private/.htaccess
!uploads/private/.gitkeep
uploads/private/*/*
!uploads/private/*/.gitkeep

